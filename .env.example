DATABASE_URL=postgresql+psycopg://crowd:crowd@localhost:5432/crowd_monitoring
POSTGRES_DB=crowd_monitoring
POSTGRES_USER=crowd
POSTGRES_PASSWORD=crowd
JWT_SECRET_KEY=development-only-replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
VIDEO_STORAGE_PATH=storage/videos
MAX_UPLOAD_SIZE_BYTES=104857600
CV_SERVICE_URL=http://localhost:8001
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IMAGE_SIZE=640
YOLO_FRAME_STRIDE=5
# Tracking samples are independent of detection reporting samples. Skipped frames are not tracked.
TRACKER_TYPE=bytetrack
TRACK_FRAME_STRIDE=1
TRACK_HIGH_THRESHOLD=0.25
TRACK_LOW_THRESHOLD=0.1
TRACK_MATCH_THRESHOLD=0.8
# Lost-track retention in processed tracking frames, not source frames.
TRACK_BUFFER=30
CV_ANALYSIS_TIMEOUT_SECONDS=600
# Inclusive active-track count boundaries; operational categories, not safety standards.
CROWD_MODERATE_COUNT=5
CROWD_HIGH_COUNT=10
CROWD_VERY_HIGH_COUNT=20
# Backend spatial grid dimensions, each 1..128. Stored with every heatmap.
HEATMAP_GRID_WIDTH=32
HEATMAP_GRID_HEIGHT=18
# Browser frames are transient; REST ingestion, WebSocket metrics; one backend and one CV worker.
LIVE_TARGET_FPS=3
LIVE_MAX_FRAME_BYTES=524288
LIVE_MAX_FRAME_PIXELS=921600
LIVE_RECENT_OBSERVATIONS=300
LIVE_SESSION_STALE_SECONDS=10
LIVE_WORKER_IDLE_SECONDS=120
LIVE_MAX_SESSIONS=8

# Maximum dashboard subscribers per live session (one backend worker).
LIVE_WS_SUBSCRIBER_CAP=4

# Production: ENVIRONMENT=production rejects missing/placeholder JWT secrets and
# requires explicit PostgreSQL DATABASE_URL, CV_SERVICE_URL and exact HTTPS origins.
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# VITE_API_BASE_URL is public frontend build-time configuration; never put secrets in VITE_*.
# WebSocket ws/wss URL is derived from VITE_API_BASE_URL (https becomes wss).
# Compose uses its internal database/CV hostnames; optional full overrides:
# COMPOSE_DATABASE_URL=postgresql+psycopg://user:URL_ENCODED_PASSWORD@postgres:5432/crowd_monitoring
# COMPOSE_CV_SERVICE_URL=http://cv-service:8001
# See docs/deployment-readiness.md before public deployment. Compose frontend is development-only.
