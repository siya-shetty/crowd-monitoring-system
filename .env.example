DATABASE_URL=postgresql+psycopg://crowd:crowd@localhost:5432/crowd_monitoring
POSTGRES_DB=crowd_monitoring
POSTGRES_USER=crowd
POSTGRES_PASSWORD=crowd
SECRET_KEY=replace-with-a-long-random-development-secret
JWT_SECRET_KEY=development-only-replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
VIDEO_STORAGE_PATH=storage/videos
MAX_UPLOAD_SIZE_BYTES=104857600
CV_SERVICE_URL=http://localhost:8001
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IMAGE_SIZE=640
YOLO_FRAME_STRIDE=5
# Tracking samples are independent of detection reporting samples. Skipped frames are not tracked.
TRACKER_TYPE=bytetrack
TRACK_FRAME_STRIDE=1
TRACK_HIGH_THRESHOLD=0.25
TRACK_LOW_THRESHOLD=0.1
TRACK_MATCH_THRESHOLD=0.8
# Lost-track retention in processed tracking frames, not source frames.
TRACK_BUFFER=30
CV_ANALYSIS_TIMEOUT_SECONDS=600
# Inclusive active-track count boundaries; operational categories, not safety standards.
CROWD_MODERATE_COUNT=5
CROWD_HIGH_COUNT=10
CROWD_VERY_HIGH_COUNT=20
# Backend spatial grid dimensions, each 1..128. Stored with every heatmap.
HEATMAP_GRID_WIDTH=32
HEATMAP_GRID_HEIGHT=18
# Phase 9: browser frames are transient, REST only; one backend and one CV worker.
LIVE_TARGET_FPS=3
LIVE_MAX_FRAME_BYTES=524288
LIVE_MAX_FRAME_PIXELS=921600
LIVE_RECENT_OBSERVATIONS=300
LIVE_SESSION_STALE_SECONDS=10
LIVE_WORKER_IDLE_SECONDS=120
LIVE_MAX_SESSIONS=8
